# Hybrid AI Trading Desk — environment template
# Copy to .env and fill values. NEVER commit real secrets.
# NOTE: docs/TRADING_DESK_SPEC.md Bagian 11 is truncated in this repo snapshot;
# variables below are derived from AGENTS.md, IMPLEMENTATION_PLAN.md, and
# readable sections of TRADING_DESK_SPEC.md. Extend as spec Bagian 11 dictates.

# -----------------------------------------------------------------------------
# Core infrastructure
# -----------------------------------------------------------------------------
POSTGRES_DB=trading_desk
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading:change_me@postgres:5432/trading_desk

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Service ports / URLs
RUST_CORE_PORT=8080
RUST_CORE_BASE_URL=http://rust-core:8080
AI_WORKER_PORT=8000
AI_WORKER_BASE_URL=http://ai-worker:8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

# -----------------------------------------------------------------------------
# Market data / adapters
# -----------------------------------------------------------------------------
# Binance (Indonesia-friendly REST base; WS uses default Binance stream endpoint)
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
# Optional outbound proxy for restricted networks, e.g. http://user:pass@host:port
OUTBOUND_PROXY_URL=

# US equities / fundamentals
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
FINNHUB_API_KEY=

# Forex
TWELVE_DATA_API_KEY=

# IDX / fallback market data
YFINANCE_ENABLED=true

# -----------------------------------------------------------------------------
# LLM router (OpenCode Zen / OpenCode Go + fallbacks) — OpenAI-compatible
# -----------------------------------------------------------------------------
# Primary provider: opencode_zen | opencode_go | gemini_free | groq_free | openrouter_free | ollama
LLM_PRIMARY_PROVIDER=opencode_zen
LLM_FALLBACK_PROVIDERS=opencode_go

# Free-tier pacing / safety
FREE_TIER_MODE=true
LLM_MAX_CONCURRENCY=1
LLM_NODE_DELAY_MS=1500
LLM_REQUEST_TIMEOUT_SECS=60

# OpenCode Zen (OpenAI-compatible)
OPENCODE_ZEN_BASE_URL=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=

# OpenCode Go (OpenAI-compatible)
OPENCODE_GO_BASE_URL=
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=

# Optional fallbacks (OpenAI-compatible or provider-specific)
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=

# Vision (graceful degradation when empty/unsupported/rate-limited)
VISION_MODEL=
ENABLE_CHART_VISION=false

# -----------------------------------------------------------------------------
# Scouting / risk defaults
# -----------------------------------------------------------------------------
SCOUT_MAX_DEEP_DIVE=3
MAX_DEBATE_ROUNDS=1
MIN_RR_RATIO=1.5
DAILY_DRAWDOWN_LIMIT_PCT=2.0
WEEKLY_DRAWDOWN_LIMIT_PCT=5.0

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
RUST_LOG=info,rust_core=debug
TZ=Asia/Jakarta
LOG_LEVEL=INFO
